# NBA Daily Bot Configuration Template
# Copy this file to .env and fill in your actual values

# ============================================
# BallDontLie API Configuration
# ============================================
# Get free API key from https://www.balldontlie.io
# Sign up, verify email, and copy your API key
BALLDONTLIE_API_KEY=your-api-key-here

# ============================================
# Email Configuration (SMTP)
# ============================================
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=ton.email@gmail.com
MAIL_SMTP_PASSWORD=TON_APP_PASSWORD
NEWS_RECIPIENT=ton.email@gmail.com

# ============================================
# AI Model Configuration
# ============================================
# Set to 'false' to use local model (default), 'true' to use HuggingFace Inference API
USE_HF_INF_API=false

# Only needed if USE_HF_INF_API=true
HF_API_TOKEN=hf_xxxxxxxxxxxxx

# Model to use (see https://huggingface.co/ for options)
MODEL_ID=EleutherAI/gpt-neo-125M

# Maximum tokens to generate (higher = longer newsletter)
MAX_TOKENS=2000

# ============================================
# Scheduler Configuration
# ============================================
# Time to run the bot daily (24-hour format HH:MM)
BOT_RUN_TIME=09:00

# Timezone
TIMEZONE=Europe/Paris

# ============================================
# Other Configuration
# ============================================
CACHE_PATH=./data/cache.db
